<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Background runs: a data-sync foreground service streams the agent's network response while the app is
         not on screen, and notifications show progress, approvals and finished replies. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AgentApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_sandbox"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SandboxAgent"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".AgentRunService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name=".RunActionReceiver"
            android:exported="false" />
        <!-- Each mini app opens as its own document in recents. -->
        <activity
            android:name=".MiniAppActivity"
            android:documentLaunchMode="intoExisting"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- Receives a mini app shared as one .html file. -->
        <activity
            android:name=".MiniAppImportActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Add mini app"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/html" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/html" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
        <!-- Quick Settings tile that opens the app ready for voice input. -->
        <service
            android:name=".AskTileService"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="Ask agent"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- The OpenRouter sign-in page links here. It closes at once, returning to the open app. -->
        <activity
            android:name=".SignInReturnActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="icalchemy-openrouteragent" android:host="signed-in" />
            </intent-filter>
        </activity>
    </application>
</manifest>
